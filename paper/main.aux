\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Iteration speed-up of \textsc  {AGNS}-Lookahead over \textsc  {GNS}-Inexact.} \emph  {Left}: Rosenbrock-NLE for $p\in \{2,3,4,5,6,8\}$, $x_0=(-2,2)$, $f^\star =0$. \emph  {Right}: Chebyshev polynomial chain at $p=4$, $n\in \{200,500,1000,2000\}$. The $y$-axis is the number of outer iterations to reach $f(x_k)-f^\star <10^{-8}$. Both methods use identical Hessian approximations, identical $\gamma _0=1$, and the same adaptive-search rule. \textsc  {AGNS}\ reduces iteration count by $1.6$--$2.3\times $ on Rosenbrock-NLE and $1.30$--$1.42\times $ on Chebyshev. Per-iteration convergence curves at every $p$ are in \cref  {fig:psweep} (appendix).}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:speedup}{{1}{3}{\textbf {Iteration speed-up of \AGNS -Lookahead over \GNS -Inexact.} \emph {Left}: Rosenbrock-NLE for $p\in \{2,3,4,5,6,8\}$, $x_0=(-2,2)$, $f^\star =0$. \emph {Right}: Chebyshev polynomial chain at $p=4$, $n\in \{200,500,1000,2000\}$. The $y$-axis is the number of outer iterations to reach $f(x_k)-f^\star <10^{-8}$. Both methods use identical Hessian approximations, identical $\gamma _0=1$, and the same adaptive-search rule. \AGNS \ reduces iteration count by $1.6$--$2.3\times $ on Rosenbrock-NLE and $1.30$--$1.42\times $ on Chebyshev. Per-iteration convergence curves at every $p$ are in \cref {fig:psweep} (appendix)}{figure.caption.2}{}}
\newlabel{fig:speedup@cref}{{[figure][1][]1}{[1][2][]3}{}{}{}}
