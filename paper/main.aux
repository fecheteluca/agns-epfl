\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Methods compared. \emph  {Apx.\ Hess.}: uses a PSD approximation of $\nabla ^2 f$ instead of the true Hessian.}}{3}{table.caption.1}\protected@file@percent }
