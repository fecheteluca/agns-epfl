\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Convergence on representative non-convex benchmarks.} \emph  {Left}: Rosenbrock-NLE $p=5$ from $x_0=(-2,2)$. \emph  {Right}: Chebyshev polynomial chain, $n=1000, p=4$, $x_0\sim U[0,1]^n$. Trajectories truncated at the first iterate satisfying $f(x_k)-f^\star <10^{-8}$; logarithmic $y$-axis. \textsc  {AGNS}-Lookahead (magenta, ours) reaches the target before any \textsc  {GNS}\ variant on both problems; \textsc  {AGNS}-Iterate (orange dotted) tracks but never beats \textsc  {AGNS}-Lookahead.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:convergence}{{3}{4}{\textbf {Convergence on representative non-convex benchmarks.} \emph {Left}: Rosenbrock-NLE $p=5$ from $x_0=(-2,2)$. \emph {Right}: Chebyshev polynomial chain, $n=1000, p=4$, $x_0\sim U[0,1]^n$. Trajectories truncated at the first iterate satisfying $f(x_k)-f^\star <10^{-8}$; logarithmic $y$-axis. \AGNS -Lookahead (magenta, ours) reaches the target before any \GNS \ variant on both problems; \AGNS -Iterate (orange dotted) tracks but never beats \AGNS -Lookahead}{figure.caption.7}{}}
\newlabel{fig:convergence@cref}{{[figure][3][]3}{[1][4][]4}{}{}{}}
\@writefile{toc}{\contentsline {section}{Appendix\nobreakspace  C: Algorithm details}{4}{section*.13}\protected@file@percent }
\newlabel{app:algo}{{C}{4}{\appendixname \nobreakspace \thesectiondis \\* Algorithm details}{section*.13}{}}
\newlabel{app:algo@cref}{{[section][3][]C}{[1][4][]4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Per-iteration convergence on the Rosenbrock-NLE $p$-sweep.} Six panels for $p\in \{2,3,4,5,6,8\}$, all from $x_0=(-2,2)$, $f^\star =0$, $\varepsilon =10^{-8}$. \textsc  {AGNS}-Lookahead (magenta) is the fastest method on every panel. Plain gradient and FISTA (gray, black) diverge cleanly at $p\geq 6$. The horizontal axis is truncated at $200$ iterations for readability; tails of \emph  {Gradient} on $p\in \{2,3,4,5\}$ extend to several thousand iterations (\cref  {tab:rosenbrock_sweep}).}}{4}{figure.caption.8}\protected@file@percent }
\newlabel{fig:psweep}{{4}{4}{\textbf {Per-iteration convergence on the Rosenbrock-NLE $p$-sweep.} Six panels for $p\in \{2,3,4,5,6,8\}$, all from $x_0=(-2,2)$, $f^\star =0$, $\varepsilon =10^{-8}$. \AGNS -Lookahead (magenta) is the fastest method on every panel. Plain gradient and FISTA (gray, black) diverge cleanly at $p\geq 6$. The horizontal axis is truncated at $200$ iterations for readability; tails of \emph {Gradient} on $p\in \{2,3,4,5\}$ extend to several thousand iterations (\cref {tab:rosenbrock_sweep})}{figure.caption.8}{}}
\newlabel{fig:psweep@cref}{{[figure][4][]4}{[1][4][]4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {LogSumExp on real LIBSVM data} (a9a, mushrooms; $\mu =0.1$). The benchmark where \textsc  {AGNS}\ does \emph  {not} accelerate convergence: \textsc  {GNS}-Exact already attains quadratic local convergence and reaches the target in $18$ and $24$ iterations respectively, fewer than \textsc  {AGNS}-Lookahead's $40$ and $57$. Note that the residuals shown are not zero; the true optimum is offset by the construction of \cite  {semenov2025gradient}.}}{4}{figure.caption.9}\protected@file@percent }
\newlabel{fig:appendix_lse}{{5}{4}{\textbf {LogSumExp on real LIBSVM data} (a9a, mushrooms; $\mu =0.1$). The benchmark where \AGNS \ does \emph {not} accelerate convergence: \GNS -Exact already attains quadratic local convergence and reaches the target in $18$ and $24$ iterations respectively, fewer than \AGNS -Lookahead's $40$ and $57$. Note that the residuals shown are not zero; the true optimum is offset by the construction of \cite {semenov2025gradient}}{figure.caption.9}{}}
\newlabel{fig:appendix_lse@cref}{{[figure][5][]5}{[1][4][]4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Matrix-solve count vs.\ accuracy} on nonlinear equations ($n=100, m=200, p=4$). Each iteration of every Newton-type method costs one linear solve (\textsc  {GNS}-Exact: dense Cholesky; \textsc  {GNS}-WSM and \textsc  {AGNS}-WSM: Sherman--Morrison closed form). \textsc  {AGNS}-WSM-Lookahead needs roughly half as many solves as \textsc  {GNS}-Exact to reach the same residual.}}{5}{figure.caption.10}\protected@file@percent }
\newlabel{fig:matrix_inv}{{6}{5}{\textbf {Matrix-solve count vs.\ accuracy} on nonlinear equations ($n=100, m=200, p=4$). Each iteration of every Newton-type method costs one linear solve (\GNS -Exact: dense Cholesky; \GNS -WSM and \AGNS -WSM: Sherman--Morrison closed form). \AGNS -WSM-Lookahead needs roughly half as many solves as \GNS -Exact to reach the same residual}{figure.caption.10}{}}
\newlabel{fig:matrix_inv@cref}{{[figure][6][]6}{[1][4][]5}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Iterations to $\varepsilon =10^{-8}$ on the Rosenbrock-NLE $p$-sweep ($x_0=(-2,2)$). Apples-to-apples: every method uses the same Fisher / $J^\top J$+Fisher approximation. ``---'' marks \texttt  {line\_search\_diverged}. Best Newton-type method per row in \textbf  {bold}.}}{5}{table.caption.11}\protected@file@percent }
\newlabel{tab:rosenbrock_sweep}{{II}{5}{Iterations to $\varepsilon =10^{-8}$ on the Rosenbrock-NLE $p$-sweep ($x_0=(-2,2)$). Apples-to-apples: every method uses the same Fisher / $J^\top J$+Fisher approximation. ``---'' marks \texttt {line\_search\_diverged}. Best Newton-type method per row in \textbf {bold}}{table.caption.11}{}}
\newlabel{tab:rosenbrock_sweep@cref}{{[table][2][]II}{[1][4][]5}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Iterations and wall-clock time to $\varepsilon =10^{-8}$ on the Chebyshev chain dimension sweep ($p=4$). Wall-clock is dominated by the $O(n^3)$ Cholesky of \textsc  {GNS}\ variants.}}{5}{table.caption.12}\protected@file@percent }
\newlabel{tab:cheb_sweep}{{III}{5}{Iterations and wall-clock time to $\varepsilon =10^{-8}$ on the Chebyshev chain dimension sweep ($p=4$). Wall-clock is dominated by the $O(n^3)$ Cholesky of \GNS \ variants}{table.caption.12}{}}
