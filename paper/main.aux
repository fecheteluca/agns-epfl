\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Wall-clock comparison} on $f(x){=}\tfrac  {1}{4}\left \lVert Ax{-}b\right \rVert ^4$, $A\in \mathbb  {R}^{100\times 200}$, with metric $B = A^\top A + 10^{-8}I$. The \textsc  {WSM}-based solvers reach the target two orders of magnitude faster than \textsc  {GNS}-Exact. Both axes are logarithmic. Matrix-solve count for the same run is in \cref  {fig:matrix_inv}.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:wsm}{{2}{4}{\textbf {Wall-clock comparison} on $f(x){=}\tfrac {1}{4}\norm {Ax{-}b}^4$, $A\in \R ^{100\times 200}$, with metric $B = A^\top A + 10^{-8}I$. The \WSM -based solvers reach the target two orders of magnitude faster than \GNS -Exact. Both axes are logarithmic. Matrix-solve count for the same run is in \cref {fig:matrix_inv}}{figure.caption.3}{}}
\newlabel{fig:wsm@cref}{{[figure][2][]2}{[1][2][]4}{}{}{}}
